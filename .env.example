# Copie para .env (que não vai para o git) e preencha só o que quiser usar.
# No GitHub Pages, o CI lê estes valores de Settings → Secrets and variables → Actions → Variables.
# Nada aqui é segredo: tudo que começa com VITE_ fica visível no jogo publicado.

# Endereço do servidor de salas do online (wss://… em produção). Vazio = mesmo host, porta 8787.
VITE_NET_URL=

# Link do botão "Apoie o desenvolvedor" na tela inicial (Ko-fi, LivePix, Buy Me a Coffee…).
# Precisa ser https://. Vazio = botão escondido.
VITE_SUPPORT_URL=
# Texto do botão. Vazio = "Apoie o desenvolvedor".
VITE_SUPPORT_LABEL=

# Anúncios de portal (src/ads). Vazio ou "nenhum" = sem anúncios. Builds de portal escondem o
# botão de apoio, porque os portais não aceitam links para fora do jogo.
VITE_ADS=
